# Copie para .env e ajuste. NUNCA versione o .env (já está no .gitignore).
AMBIENTE=desenvolvimento

# Banco (MySQL 8.0). Com Docker Compose, o contêiner da API troca DB_HOST por "db" sozinho.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nassau_tickets
DB_USER=nassau
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# JWT: gere com  python -c "import secrets; print(secrets.token_urlsafe(48))"  (mínimo 16 caracteres)
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRA_MIN=480

# Front-ends permitidos (separe por vírgula)
CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173

# Expediente (fuso fixo America/Recife)
EXPEDIENTE_INICIO=07:00
EXPEDIENTE_FIM=17:00

# SÓ para demonstração fora do horário (ADR-004): ignora o expediente. NUNCA em produção.
EXPEDIENTE_FORCAR_ABERTO=false

LOG_NIVEL=INFO
